# Unattended install: cp claims-desk.conf.example claims-desk.conf, fill it in, then
#   sudo ./install.sh --config claims-desk.conf
# Shell syntax. Put passwords in single quotes. Delete this file after the install:
# the application password is kept in /etc/claims-desk/api.json (mode 0640).

# PostgreSQL endpoint. Single instance: the database VM, port 5432.
# NDB PostgreSQL HA: the HAProxy address, port 5000 (read/write).
DB_HOST=''
DB_PORT=5432

# Admin account used once, to create the app role and database (NDB: the
# database password you set at provisioning, user postgres). Leave DB_ADMIN_USER
# empty if the app role and database already exist; then DB_APP_PASSWORD is required.
DB_ADMIN_USER='postgres'
DB_ADMIN_PASSWORD=''
DB_ADMIN_DB='postgres'

# Application database and role. Created if missing. Empty password = generated.
DB_NAME='claims'
DB_APP_USER='claims_app'
DB_APP_PASSWORD=''
DB_SSLMODE='prefer'

# Portal
SERVER_NAME=''           # TLS name; empty = this VM's FQDN
TLS_CERT=''              # optional PEM certificate; empty = self-signed
TLS_KEY=''               # optional PEM private key
SITE_NAME='Claims Desk'
ENVIRONMENT='Prod'       # shown in the header: Prod or UAT
SEED_COUNT=12            # sample claims loaded into an empty table; 0 = none

# Stage 4 and 5. The web tier calls this URL. Empty: the first --stage 4 deploys
# the pods and fills it in. Set it only for pods you deployed yourself, without a
# kubeconfig. Switching back to stage 3 points the web tier at the portal middleware again.
POD_API_URL=''

# Windows DNS. install.sh registers this VM. update.sh --stage 3 registers the
# document VM. The zone must allow nonsecure dynamic updates.
DNS_SERVER='10.55.19.6'
DNS_ZONE='ntnxlab.local'

# Stage 3, used by: sudo ./update.sh --stage 3 --config claims-desk.conf -y
# The script runs on the portal VM and installs the document service over SSH.
# NFSv3, by name or IP. Objects TLS is not verified. Delete this file after the run:
# the Objects keys are kept on the document VM, and a root-only copy for the
# next update is /root/.claims-desk-stage3 on the portal.
DOC_HOST=''              # document VM IPv4 address
DOC_SSH_USER='root'      # rocky works when that account has passwordless sudo
DOC_SSH_KEY=''           # empty tries the agent, then /root/.ssh/claims-desk-lab
# DOC_SSH_PASSWORD=''    # used when no key works; prefer a key
NFS_EXPORT=''            # labFS.ntnxlab.local:/documents or 10.10.140.11:/claims-docs
NFS_MOUNT='/mnt/claims-docs'
S3_ENDPOINT=''           # https://objects-ip-or-name
S3_BUCKET='claims'
S3_ACCESS_KEY=''
S3_SECRET_KEY=''
S3_REGION='us-east-1'

# Stage 4, used by: sudo ./update.sh --stage 4 --config claims-desk.conf -y
# Deploys the API pods with Helm. Files and Objects come from the stage 3 lines
# above (or /root/.claims-desk-stage3); the database from /etc/claims-desk/api.json.
# The kubeconfig is copied to /root/.claims-desk/kubeconfig (0600).
KUBECONFIG_FILE=''       # path on the portal VM, e.g. /root/nkp-mgmt.conf
K8S_NAMESPACE='claims'
STAGE4_LB_IP=''          # empty = MetalLB picks an address from its pool
STAGE4_RUN_AS_UID=''     # empty = uid of claimsdesk on the document VM (read over SSH)
STAGE4_RUN_AS_GID=''     # empty = its gid, or the uid
IMAGE=''                 # empty = ghcr.io/apjgase/claims-desk-demo:<bundle version>
# KUBECTL_URL=''         # internal mirror for the kubectl binary
# HELM_URL=''            # internal mirror for the helm linux-amd64 tarball

# Stage 5, used by: sudo LLM_API_KEY='...' ./update.sh --stage 5 --config claims-desk.conf -y
# Deploys the chat pods next to the API pods. They call an OpenAI-compatible endpoint
# (NAI, vLLM). Give the API key in the environment or at the prompt, not in this file:
# it is written only to Secret claims-desk-chat in K8S_NAMESPACE. The other settings
# are kept in /root/.claims-desk/stage5 for the next run.
LLM_BASE_URL=''          # ends in /v1, e.g. https://ai.example/enterpriseai/v1
LLM_MODEL='gpt-oss-120b'         # chat model; must support tool calls
LLM_VISION_MODEL='gemma-4-26b-a4b'   # photo descriptions; must accept images
LLM_VERIFY_TLS='true'    # false for an endpoint with a lab CA certificate the image does not trust
CHAT_LB_IP=''            # empty = MetalLB picks an address from its pool

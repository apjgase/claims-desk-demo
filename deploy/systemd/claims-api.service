[Unit]
Description=Claims Desk middleware API
After=network-online.target
Wants=network-online.target

[Service]
User=claimsdesk
Group=claimsdesk
Environment=CLAIMS_CONFIG=/etc/claims-desk/api.json
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/claims-desk/app
ExecStart=/opt/claims-desk/venv/bin/uvicorn claimsdesk.api:app --host 127.0.0.1 --port 8000 --workers 2 --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
